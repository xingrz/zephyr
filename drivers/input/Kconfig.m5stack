config INPUT_M5STACK_UNIT_BYTEBUTTON
	bool "M5Stack Unit ByteButton/Switch input driver"
	default y
	depends on (DT_HAS_M5STACK_UNIT_BYTEBUTTON_ENABLED && DT_HAS_M5STACK_UNIT_BYTEBUTTON_INPUT_ENABLED) || \
		   (DT_HAS_M5STACK_UNIT_BYTESWITCH_ENABLED && DT_HAS_M5STACK_UNIT_BYTESWITCH_INPUT_ENABLED)
	select I2C
	help
	  Enable the M5Stack Unit ByteButton/Switch input driver

config INPUT_M5STACK_INIT_PRIORITY
	int "Initialization priority for M5Stack input drivers"
	default 91
	help
	  Initialization priority for M5Stack input device drivers.

	  This priority must be higher than that of the M5Stack extension MFDs
	  to ensure proper initialization ordering.
