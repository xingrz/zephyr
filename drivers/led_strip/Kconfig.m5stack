config LED_STRIP_M5_EXPANSION
	bool "M5Stack expansion LED strip driver"
	default y
	depends on DT_HAS_M5STACK_EXPANSION_LED_STRIP_ENABLED
	depends on DT_HAS_M5STACK_GROVE_PORTA_ENABLED || DT_HAS_M5STACK_MBUS_ENABLED
	select I2C
	help
	  Enable the M5Stack expansion LED strip driver

config LED_STRIP_M5_EXPANSION_INIT_PRIORITY
	int "Initialization priority for M5Stack expansion LED strip drivers"
	default 92
	help
	  Initialization priority for M5Stack expansion LED strip device drivers.

	  This priority must be greater than that of the M5Stack expansion MFDs
	  to ensure proper initialization ordering.
